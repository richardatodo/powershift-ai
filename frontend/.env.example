# Public browser configuration only. Never put client secrets or database URLs in VITE_ variables.
VITE_OIDC_AUTHORITY=https://your-oidc-provider.example/
VITE_OIDC_CLIENT_ID=your-public-browser-client-id
VITE_OIDC_SCOPE=openid profile email
# Set only if your provider requires an audience parameter to issue an API access token.
# VITE_OIDC_AUDIENCE=your-api-audience

# Development-server configuration; not included in the browser bundle.
POWERSHIFT_API_PROXY=http://127.0.0.1:8000
